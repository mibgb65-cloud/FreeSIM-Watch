{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freesim-watch",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg"]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freesim-watch",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://REPLACE_WITH_YOUR_WORKER_OR_DOMAIN",
    "LINUXDO_AUTHORIZE_URL": "https://connect.linux.do/oauth2/authorize",
    "LINUXDO_TOKEN_URL": "https://connect.linux.do/oauth2/token",
    "LINUXDO_USER_URL": "https://connect.linux.do/api/user",
    "MAX_MONITORS_PER_USER": "3",
    "MAX_REGISTERED_USERS": "10",
    "LEGACY_OWNER_USER_ID": "",
    "ADMIN_USER_IDS": ""
  }
}
